{
  "name": "inmuno-mundo-vivo",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python -m http.server 8090 --bind 0.0.0.0",
    "build": "node scripts/build.mjs",
    "build:download": "python scripts/build_download.py",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/guided-browser.cjs",
    "test:cards": "node tests/browser.cjs",
    "trailer:check": "cd trailer && HYPERFRAMES_BROWSER_PATH=/usr/bin/chromium HYPERFRAMES_FONT_CACHE_DIR=/workspace/.cache/hyperframes/fonts npm exec --yes --cache /workspace/.npm-cache --package hyperframes@0.8.181 -- hyperframes check",
    "test:media": "node tests/media-browser.cjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
